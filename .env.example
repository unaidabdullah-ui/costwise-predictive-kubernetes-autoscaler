# CostWise configuration. Copy to .env and edit; start-demo sets the connection
# values (PROMETHEUS_URL, KUBECONFIG, ...) automatically. Never put secrets here.

# --- scaling limits -----------------------------------------------------------
MIN_REPLICAS=1
MAX_REPLICAS=8

# --- cost (simulated prices, Indian rupees) -----------------------------------
CURRENCY=INR
COST_PER_REPLICA_HOUR=5
BUDGET_PER_HOUR=35

# --- forecasting (must match the trained model: 5 s steps) ---------------------
FORECAST_HORIZON=6          # steps of 5 s -> 30 s ahead
SEQUENCE_LENGTH=12          # steps of 5 s -> 60 s of history
MIN_FORECAST_CONFIDENCE=0.4 # below this trust score -> safe mode

# --- capacity planning ---------------------------------------------------------
CAPACITY_PER_POD=20         # req/s one 250m-CPU marketplace pod can serve
TARGET_UTILIZATION=0.7
SAFETY_MARGIN=0.15

# --- stability -------------------------------------------------------------------
SCALING_INTERVAL=5
SCALE_UP_COOLDOWN=10
SCALE_DOWN_COOLDOWN=20
STABILIZATION_WINDOW_SECONDS=60
MAX_SCALE_UP_STEP=4
MAX_SCALE_DOWN_STEP=3

# --- optimiser --------------------------------------------------------------------
OPTIMIZER_MODE=cost_aware   # cost_aware | predictive
CONTROLLER_MODE=active      # active | observe (decide but never apply)
SLA_PENALTY_PER_RPS=2.0
CHANGE_PENALTY=0.2

# --- simulated shoppers (set on the traffic-generator Deployment) ---------------
WORKLOAD_RATE=0.04          # requests per second per shopper

# --- logging -------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text
